FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
COPY web/default/package.json ./default/package.json
COPY web/classic/package.json ./classic/package.json
RUN bun install --frozen-lockfile
COPY ./web/default ./default
COPY ./VERSION /build/VERSION
RUN cd default && DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

# Classic theme: build in an isolated single-package workspace so date-fns v2
# (required by @douyinfe/semi-ui@2.x) is hoisted, not date-fns v4 (used by the
# default theme). Sharing the top-level node_modules makes date-fns-tz resolve
# to date-fns v4, whose `exports` map no longer exposes the internal subpaths
# date-fns-tz imports — breaking the classic build.
FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS builder-classic

WORKDIR /build/classic-web
# Reuse the workspace root but declare only `classic` as a workspace so bun
# resolves date-fns v2 for classic without pulling default's date-fns v4.
COPY web/package.json ./
RUN sed -i 's/"workspaces": \[[^]]*\]/"workspaces": ["classic"]/' package.json
COPY web/classic/package.json ./classic/package.json
RUN bun install --no-save
COPY ./web/classic ./classic
COPY ./VERSION /build/VERSION
RUN cd classic && VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder2
ENV GO111MODULE=on CGO_ENABLED=0

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=builder /build/web/default/dist ./web/default/dist
COPY --from=builder-classic /build/classic-web/classic/dist ./web/classic/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata bash curl \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && apk del tzdata

COPY --from=builder2 /build/new-api /
COPY --from=builder2 /build/web/default/dist /web/default/dist
COPY --from=builder2 /build/web/classic/dist /web/classic/dist
COPY --from=builder2 /build/VERSION /VERSION

WORKDIR /data
EXPOSE 3000
ENTRYPOINT ["/new-api"]
